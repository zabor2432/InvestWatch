# --- Database (PostgreSQL; the `dagster` database is created by db/init.sql) ---
POSTGRES_USER=investwatch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=investwatch
# host port for DB clients (DBeaver, TablePlus): localhost:POSTGRES_HOST_PORT
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql://investwatch:change-me@db:5432/investwatch
DAGSTER_DATABASE_URL=postgresql://investwatch:change-me@db:5432/dagster

# --- Compose profiles ---
# The scraper stack (redis, searxng, migrations, scraper, scraper-worker) is off by default.
# Enable it with: COMPOSE_PROFILES=scraper   (or: docker compose --profile scraper up)
COMPOSE_PROFILES=

# --- Object storage (MinIO, S3 API) ---
MINIO_ROOT_USER=investwatch
MINIO_ROOT_PASSWORD=change-me-minio
S3_ENDPOINT_URL=http://minio:9000
# Pipeline bucket: input records and images read by Dagster, images served to the UI by the backend
PIPELINE_S3_BUCKET=investwatch
# Scraper media bucket (images and video thumbnails, public read) and how the browser reaches MinIO
S3_BUCKET=investwatch-media
# host ports of MinIO (API / console); if 9000 is taken (e.g. by a VPN client), change both lines below
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
S3_PUBLIC_URL=http://localhost:9000

# --- Decision model (OpenJev hosted by Codiv). Only the key is required ---
# Free account and key: https://codiv.ai/signup, then https://codiv.ai/dashboard
TYPESAFE_API_KEY=
# Optional (defaults shown):
# TYPESAFE_BASE_URL=https://api.codiv.ai
# JEV_MODEL=openjev-latest        # others: clef-1.0, clef-flash-1.0 (accept images); laya-1.0, verdict-1.4, clm-v0.1, jevk5-0.3 are text-only (module 2 sends screenshots)
# The same model locally on a GPU (github.com/razorback16/openjev, `docker compose up -d`):
# TYPESAFE_BASE_URL=http://host.containers.internal:8080   (no key needed)

# Score from which a result raises a real-time high_risk alert (independent of the UI calibration threshold)
ALERT_THRESHOLD=0.9

# Optional speech-to-text step in Dagster (off: no audio/video input yet; needs torch/transformers/ffmpeg, see orchestrator/AGENTS.md)
# TRANSCRIBE_ENABLED=false
# TRANSCRIBE_MODEL=openai/whisper-large-v3-turbo   # lighter: bardsai/whisper-small-pl

# Defaults of the Dagster run config (overridable per run in the Launchpad): documents per run, and how far back
# (days) already-scored documents are re-scored after the model changes. New and changed documents are always taken.
BATCH_SIZE=50
REPROCESS_LOOKBACK_DAYS=30

# --- Scraper (only with COMPOSE_PROFILES=scraper) ---
REDIS_URL=redis://redis:6379/0
SEARXNG_URL=http://searxng:8080
SEARXNG_SECRET=change-me-to-a-long-random-string

# schedule (cron syntax; empty = off) and limits
# after every job new posts go to the pipeline bucket PIPELINE_S3_BUCKET (contract v2, no duplicates); false = only on POST /landing/sync
LANDING_SYNC=true
SCHEDULER_ENABLED=true
SCRAPE_CRON=0 */6 * * *
REGISTRY_SYNC_CRON=0 3 * * *
SCRAPE_SOURCES=youtube,telegram,web,reddit,wykop,substack
DEFAULT_LIMIT=20
MAX_QUERIES_PER_RUN=30
SINCE_DAYS=90
REQUEST_DELAY_SECONDS=1.5
TELEGRAM_CHANNELS_PER_QUERY=3
SUBSTACK_PUBLICATIONS_PER_QUERY=3
PLAYWRIGHT_ENABLED=true
# comma-separated HTTP(S) proxies, e.g. http://user:pass@host:port,http://host2:port (empty = direct)
PROXY_LIST=

# optional collectors (free keys; empty = collector skipped)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
WYKOP_APP_KEY=
WYKOP_APP_SECRET=

# registry sources
ISCAN_NCA_IDS=75
ISCAN_MONTHS=24
LOG_LEVEL=INFO
